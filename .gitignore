# Dart / Flutter
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.melos_*

# Native intermediates
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/macos/Pods/
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/
**/android/.gradle/
**/android/local.properties
**/android/key.properties
# Release signing material: CI decodes these from secrets at build time and
# shreds them after. A committed keystore is a compromised keystore.
**/android/app/*.keystore
**/android/app/*.jks
*.p12
*.mobileprovision

# OS
.DS_Store

# Local tooling artefacts, matching MadarRust: Claude settings are per-machine,
# and .ua/ is a regenerable knowledge-graph dump (~5 MB).
.claude/
.ua/

# PGP / integration secrets — never in git.
# The Talabat private key lives OUTSIDE any repo, in ~/.talabat-pgp (see
# Madar/TALABAT_INTEGRATION.md). These patterns are the second lock.
*.asc
*.gpg
*.pgp
*.key
*.pem
*.p12
secring.*
openpgp-revocs.d/
.talabat-pgp/

# Firebase, per app (APP-6: the staff app and the POS). These repos are PUBLIC:
# the generated client config carries the project's API key and app ids, and
# the service-account JSON and the APNs .p8 are outright credentials. None of
# them belong here. Regenerate the client config in each app with:
#   cd apps/staff && flutterfire configure --project=dawam-by-madar
#   cd apps/madar && flutterfire configure --project=dawam-by-madar
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
**/firebase.json
**/AuthKey_*.p8
*service-account*.json
# What the Firebase console actually names the server key it hands you.
*firebase-adminsdk*.json

# Kotlin build cache.
**/.kotlin/
