# Dart / Flutter
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.melos_*

# Native intermediates
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/macos/Pods/
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/
**/android/.gradle/
**/android/local.properties
**/android/key.properties
# Release signing material: CI decodes these from secrets at build time and
# shreds them after. A committed keystore is a compromised keystore.
**/android/app/*.keystore
**/android/app/*.jks
*.p12
*.mobileprovision

# OS
.DS_Store

# Local tooling artefacts, matching MadarRust: Claude settings are per-machine,
# and .ua/ is a regenerable knowledge-graph dump (~5 MB).
.claude/
.ua/
