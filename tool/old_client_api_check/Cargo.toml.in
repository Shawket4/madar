# Template. tool/old_client_api_check.sh copies this harness next to a temp
# worktree of an OLD POS release and substitutes @MADAR_API@ with that
# worktree's rust-core/crates/madar-api. Not a member of the rust-core workspace.
[package]
name = "old_client_api_check"
version = "0.0.0"
edition = "2021"
publish = false

[workspace]

[features]
# Exactly one: which POS release's generated models are being checked.
v050 = ["till"]
v051 = ["till"]
v060 = ["till"]
v061 = ["till"]
# The till goldens and envelopes name models only those releases have.
till = []
# The releases on stores when stamp tracks landed (loyalty_tracks_parse).
v0130 = []
v0140 = []
v0171 = []

[[bin]]
name = "gen_envelopes"
path = "src/bin/gen_envelopes.rs"
required-features = ["till"]

[[test]]
name = "golden_parse"
path = "tests/golden_parse.rs"
required-features = ["till"]

[[test]]
name = "loyalty_tracks_parse"
path = "tests/loyalty_tracks_parse.rs"

[dependencies]
madar-api = { path = "@MADAR_API@" }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
uuid = { version = "1", features = ["serde"] }
chrono = { version = "0.4", features = ["serde"] }
