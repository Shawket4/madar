# Madar core configuration. Copy to `.env`; values are baked into the library
# at BUILD time by crates/madar-core/build.rs (via cargo:rustc-env), so hosts
# never carry base-url/endpoint knowledge — per the rebuild brief.
#
#   cp .env.example .env

# API base URL the generated client targets.
MADAR_BASE_URL=https://api.madar-pos.cloud

# Environment name: prod | staging | dev
MADAR_ENV=prod

# Sentry DSN for crash + background-error reporting (crates/madar-core/src/obs.rs).
# LEAVE BLANK / COMMENTED OUT TO DISABLE: with no DSN the core does not start a
# Sentry client, does not touch the `sentry_outbox` table, and behaves exactly as
# it did before reporting existed. A DSN is a public value by design (it ships
# inside every client build) — it is not a secret.
#
# Can also be set as a PROCESS env var at runtime, which takes precedence over
# this baked-in value — that's how a support build turns reporting on without a
# rebuild. Reports are PII-scrubbed on the device before they are ever queued
# (see the `scrub_event` compliance control in obs.rs).
#MADAR_SENTRY_DSN=https://f4aeabcb758c4cd1d1d12d5f5ee2a46c@sentry.madar-pos.cloud/2
